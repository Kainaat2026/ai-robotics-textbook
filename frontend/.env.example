# Backend API URL (should include /api suffix)
REACT_APP_API_URL=http://localhost:8000/api

# Feature Flags
REACT_APP_ENABLE_URDU=true
REACT_APP_ENABLE_QUIZ=true
REACT_APP_ENABLE_TEXT_SELECTION_AI=true
REACT_APP_ENABLE_PERSONALIZATION=true

# Analytics (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=

# Environment
REACT_APP_ENVIRONMENT=development
