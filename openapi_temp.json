stions (answers hidden)\n\nExample:\n    GET /api/quiz/chapter-01-introduction","operationId":"get_quiz_for_chapter_api_quiz__chapter_id__get","parameters":[{"name":"chapter_id","in":"path","required":true,"schema":{"type":"string","title":"Chapter Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuizDetailResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/quiz/{chapter_id}/start":{"post":{"tags":["Quiz"],"summary":"Start Quiz","description":"Start a quiz session for a chapter.\n\nRequires: Authentication\n\nArgs:\n    chapter_id: Chapter identifier\n\nReturns:\n    Quiz session with questions\n\nExample:\n    POST /api/quiz/chapter-01-introduction/start\n    Authorization: Bearer <token>","operationId":"start_quiz_api_quiz__chapter_id__start_post","security":[{"HTTPBearer":[]}],"parameters":[{"name":"chapter_id","in":"path","required":true,"schema":{"type":"string","title":"Chapter Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartQuizResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/quiz/submit":{"post":{"tags":["Quiz"],"summary":"Submit Quiz","description":"Submit quiz answers and get results.\n\nRequires: Authentication\n\nArgs:\n    request: Quiz submission with session ID and answers\n\nReturns:\n    Quiz results with score and detailed feedback\n\nExample:\n    POST /api/quiz/submit\n    Authorization: Bearer <token>\n    {\n        \"attempt_id\": \"session-uuid\",\n        \"answers\": [\n            {\"question_id\": \"q1-uuid\", \"user_answer\": \"Option A\"},\n            {\"question_id\": \"q2-uuid\", \"user_answer\": \"True\"}\n        ]\n    }","operationId":"submit_quiz_